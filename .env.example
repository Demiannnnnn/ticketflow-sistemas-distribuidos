# ========================================
# CONFIGURACIÓN GENERAL / APP2 (Flask)
# ========================================
FLASK_APP=run.py
FLASK_ENV=development
APP2_SECRET_KEY=CHANGE_ME # Clave secreta para sesiones seguras de Flask

# App2 MariaDB Connection
APP2_DB_USER=user # Usuario de base de datos para la aplicación
APP2_DB_PASSWORD=CHANGE_ME # Contraseña de la base de datos de App2
APP2_DB_HOST=app2_proxysql # Host de base de datos (apunta al balanceador ProxySQL)
APP2_DB_PORT=6033 # Puerto de conexión en ProxySQL
APP2_DB_NAME=***REMOVED*** # Nombre de la base de datos de facturación
APP2_DB_ROOT_PASSWORD=CHANGE_ME # Contraseña de root de MariaDB

# MariaDB Cluster HA & Replication
APP2_REPL_USER=repl_user # Usuario de replicación MariaDB
APP2_REPL_PASSWORD=CHANGE_ME # Contraseña para replicación MariaDB
APP2_ORCH_USER=orch_user # Usuario de topología para Orchestrator
APP2_ORCH_PASSWORD=CHANGE_ME # Contraseña de Orchestrator para descubrir topología
APP2_MONITOR_USER=monitor_user # Usuario monitor de ProxySQL
APP2_MONITOR_PASSWORD=CHANGE_ME # Contraseña para monitor de ProxySQL

# App2 Server Config
APP2_RUN_HOST=0.0.0.0
APP2_RUN_PORT=5002

# App2 Middleware Integration
MIDDLEWARE_TYPE=tcp_server # Opciones: tcp_socket, tcp_server
# MIDDLEWARE_HOST=middleware # Usado si MIDDLEWARE_TYPE es tcp_socket
MIDDLEWARE_PORT=6002 # Puerto socket para recepción de tickets
APP2_SOCKET_PORT=6002 # Puerto mapeado en host vía Nginx LB

# App2 Notification Config (Dónde App2 envía confirmaciones de pago)
# Usar 172.18.0.1 para gateway docker app2_network o host.docker.internal en Mac
MIDDLEWARE_NOTIFY_HOST=172.18.0.1
MIDDLEWARE_NOTIFY_PORT=7002

# ========================================
# APP1 - GESTOR DE RESERVAS (Go + Patroni)
# ========================================
APP1_DB_USER=postgres # Usuario de PostgreSQL
APP1_DB_PASSWORD=CHANGE_ME # Contraseña de PostgreSQL (App1 y Patroni superuser)
APP1_DB_NAME=ticketflow # Nombre de la base de datos de reservas
APP1_PATRONI_REPLICATION_PASSWORD=CHANGE_ME # Contraseña del usuario replicator en Patroni
