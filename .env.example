# ==============================================================================
# TicketFlow - Environment Configuration Example
# ==============================================================================

# --- App1 Configuration (Go + PostgreSQL/Patroni) ---
APP1_PORT=8080
APP1_DB_HOST=haproxy
APP1_DB_PORT=5432
APP1_DB_USER=postgres
APP1_DB_PASSWORD=postgres123
APP1_DB_NAME=ticketflow

# --- App2 Configuration (Flask + MariaDB) ---
FLASK_APP=run.py
FLASK_ENV=development
APP2_SECRET_KEY=dev-secret-key-change-in-production-12345
APP2_RUN_HOST=0.0.0.0
APP2_RUN_PORT=5002

# App2 Database (MariaDB via ProxySQL)
APP2_DB_USER=user
APP2_DB_PASSWORD=password
APP2_DB_HOST=app2_proxysql
APP2_DB_PORT=6033
APP2_DB_NAME=invoicing
APP2_DB_ROOT_PASSWORD=root_password

# App2 Middleware Integration
# Options: rabbitmq (recommended), tcp_socket, tcp_server
MIDDLEWARE_TYPE=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Legacy TCP socket ports (if MIDDLEWARE_TYPE is tcp_socket/tcp_server)
MIDDLEWARE_PORT=6002
APP2_SOCKET_PORT=6002

# App2 Notification Callback (where App2 notifies Middleware of payment/refunds)
MIDDLEWARE_NOTIFY_HOST=middleware
MIDDLEWARE_NOTIFY_PORT=7002

# --- App3 Configuration (Flask Portal) ---
APP3_PORT=5003
APP1_API_URL=http://nginx/api/events
APP1_RESERVE_URL=http://nginx/api/reserve
MIDDLEWARE_URL=http://middleware:8000/order

# --- Middleware Configuration (Go + Gin + RabbitMQ) ---
MIDDLEWARE_HTTP_PORT=8000
MIDDLEWARE_NOTIFY_LISTEN_PORT=7002